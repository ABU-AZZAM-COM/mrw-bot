# =====================================================================
#  متغيرات البيئة للبوت على الخادم — انسخ هذا الملف إلى .env ثم عدّل القيم
#  chmod 600 .env   (لتقييد القراءة على المالك فقط)
# =====================================================================

# توكن البوت من @BotFather (القيمة سرية — لا تشاركها)
BOT_TOKEN=

# معرّفات المشرفين مفصولة بفواصل
ADMIN_IDS=

# فرق التوقيت المحلي عن UTC (السعودية = 3)
LOCAL_UTC_OFFSET=3

# أقصى طول للوصف وعدد البلاغات المسموح لكل مبلّغ في اليوم
MAX_DESC_LEN=1500
MAX_REPORTS_PER_DAY=10
MAX_PHOTO_MB=10
