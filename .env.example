# ============================================
# إعدادات البيئة — انسخ هذا الملف إلى ".env"
# وعدّل القيم قبل تشغيل البوت
# ============================================

# توكن البوت من @BotFather (إجباري)
BOT_TOKEN=ضع_هنا_توكن_البوت

# معرف المشرفين الرقمية (Telegram User ID) — مفصولة بفواصل إن كان أكثر من واحد
ADMIN_IDS=123456789

# فرق التوقيت المحلي عن UTC (الساعات) — 3 لمكة/الرياض/صنعاء
LOCAL_UTC_OFFSET=3

# حدود اختيارية
MAX_DESC_LEN=1500
MAX_PHOTO_MB=10
MAX_REPORTS_PER_DAY=10
MAX_REPORTS_PER_MINUTE=2
MAX_REPORTS_PER_HOUR=5
MAX_REPORTS_PER_HOUR_GLOBAL=60
MAX_REPORTS_PER_DAY_GLOBAL=300
FREEZE_AFTER_STRIKES=1
FREEZE_MINUTES_FIRST=60
FREEZE_MINUTES_SECOND=1440
FREEZE_MINUTES_REPEAT=8640

# رمز مالك اللوحة (إلزامي للاتصال بخدمة الإدارة)
ADMIN_API_TOKEN=ضع_رمزًا_عشوائيًا_طويلًا_في_أسرار_الخدمة

# اختياري: رموز منفصلة بأدوار أقل صلاحية. ضع JSON صحيحًا في مخزن أسرار الاستضافة.
# الأدوار: viewer, reviewer, operator, owner. يجب أن يكون admin_id ضمن ADMIN_IDS.
# ADMIN_API_TOKENS_JSON='[{"token":"رمز-فريد","role":"reviewer","admin_id":123456789}]'

# قاعدة البيانات:
# SQLite محليًا فقط (الافتراضي خارج Render)، أو Turso للإنتاج.
# Render يفرض DB_BACKEND=turso ويرفض البدء دون بيانات الاتصال.
DB_BACKEND=sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# اختياري: تشفير طلبات توثيق المراسلين. أنشئ مفتاح Fernet عشوائيًا وخزّنه
# في أسرار الاستضافة فقط؛ لا تضع المفتاح في Git أو ترسله في المحادثات.
# عند غياب المفتاح، يبقى مسار التوثيق مغلقًا ولا تُحفظ صور الهوية.
VERIFICATION_ENCRYPTION_KEY=
# اختياري: رابط صفحة التوثيق. يمكن اشتقاقه من RENDER_EXTERNAL_URL على Render.
VERIFICATION_WEBAPP_URL=

# أداة الدخول بهويتك الشخصي (tg_login.py) — من my.telegram.org
API_ID=ضع_API_ID_هنا
API_HASH=ضع_API_HASH_هنا

# ============================================
# الأرشفة الرسمية + الاستضافة السحابية (اختيارية)
# فعّلها لتعمل في وضع "الاستضافة السحابية الدائمة"
# ============================================

# معرّف القناة الرسمية الخاصة (مثل -1001234567890)
# تُنشر فيها البلاغات تلقائيًا وتُحفظ فيها نسخ قاعدة البيانات
ARCHIVE_CHAT_ID=0

# 1 = نُحفظ نسخة من الصور على القرص | 0 = نعتمد على file_id في تلغرام فقط
# (في الاستضافة السحابية المجانية يُفضّل 0 لأن القرص غير دائم)
SAVE_MEDIA_LOCALLY=1

# رابط الخدمة على منصة الاستضافة (مثل رابط Zeabur أو Hugging Face Space)
# يُستدعى دوريًا حتى لا تُوقِف المنصة الخدمة تلقائيًا بعد خمول طويل
KEEPALIVE_URL=

# عدد الثواني بين نبرات الإبقاء النشطة (300 ثانية = 5 دقائق)
KEEPALIVE_INTERVAL_SEC=300

# عدد الدقائق بين نسختين احتياطيتين تلقائيتين من قاعدة البيانات (0 = تعطيل)
BACKUP_INTERVAL_MIN=30

# Sightengine moderation for complaint images sent to the bot in private.
# Obtain these values from your Sightengine account; never commit real credentials.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# SIGHTENGINE_SECRET is also accepted as an alias for SIGHTENGINE_API_SECRET.

# VirusTotal v3 URL scanning. Submitted URLs are shared with VirusTotal.
VIRUSTOTAL_API_KEY=

# ============================================
# لوحة الإدارة (Flutter Web) — API الحي
# ============================================
# توكن دخول لوحة الإدارة — قيمة عشوائية طويلة، ولا تشاركه علنًا
ADMIN_API_TOKEN=ضع_توكن_إدارة_قوي_هنا
# 1 = تشغيل خادم اللوحة على منفذ PORT (Render يضبطه تلقائيًا)
ADMIN_WEB_ENABLED=1
# المنابع المسموحة بالاتصال من متصفح خارجي (افتراضيًا الجميع — الحماية بالتوكن)
ADMIN_CORS_ORIGINS=*
